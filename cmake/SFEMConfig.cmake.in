@PACKAGE_INIT@

########## old style variables. Preferably you should use target_link_libraries(my_target SFEM::sfem) ################
@OLD_CMAKE_CONFIG_CONTENT@
########## end of old style variables ####################################################################################

include(CMakeFindDependencyMacro)

# Resolve transitive imported targets referenced by SFEMTargets.cmake.
# Bundled deps are installed under the same prefix when SFEM is installed.
set(_SFEM_CMAKE_LIBDIR "@CMAKE_INSTALL_LIBDIR@")
if(NOT _SFEM_CMAKE_LIBDIR)
    set(_SFEM_CMAKE_LIBDIR "lib")
endif()

macro(_sfem_find_colocated_dependency _name _subdir)
    set(_sfem_${_name}_dir "${PACKAGE_PREFIX_DIR}/${_SFEM_CMAKE_LIBDIR}/cmake/${_subdir}")
    if(NOT DEFINED ${_name}_DIR AND EXISTS "${_sfem_${_name}_dir}/${_name}Config.cmake")
        set(${_name}_DIR "${_sfem_${_name}_dir}")
    elseif(NOT DEFINED ${_name}_DIR AND EXISTS "${_sfem_${_name}_dir}/${_subdir}Config.cmake")
        set(${_name}_DIR "${_sfem_${_name}_dir}")
    endif()
    find_dependency(${_name} CONFIG)
    unset(_sfem_${_name}_dir)
endmacro()

# smesh is a mandatory submodule of SFEM.
_sfem_find_colocated_dependency(smesh smesh)

if(@SFEM_ENABLE_RYAML@)
    _sfem_find_colocated_dependency(ryml ryml)
endif()

if(@SFEM_ENABLE_SCCD@)
    _sfem_find_colocated_dependency(SCCD SCCD)
endif()

if(@SFEM_ENABLE_SSDF@)
    _sfem_find_colocated_dependency(ssdf ssdf)
endif()

if(@SFEM_ENABLE_OPENMP@)
    find_dependency(OpenMP COMPONENTS C CXX)
endif()

if(@SFEM_ENABLE_CUDA@)
    find_dependency(CUDAToolkit)
    # Header-only; older SFEM installs exported this as -lThrust.
    if(NOT TARGET Thrust)
        add_library(Thrust INTERFACE IMPORTED)
    endif()
endif()

if(@SFEM_ENABLE_BLAS@ AND NOT APPLE)
    find_dependency(BLAS)
endif()

if(@SFEM_ENABLE_LAPACK@)
    find_dependency(LAPACK)
endif()

unset(_SFEM_CMAKE_LIBDIR)

include("${CMAKE_CURRENT_LIST_DIR}/SFEMTargets.cmake")

check_required_components(SFEM)
